def command_down(args):
    files = compose_files((HERE / "compose.enterprise.yaml").is_file())
    extra = ["--volumes"] if args.volumes else []
    if args.volumes:
        say("removing the volumes: conversations, uploads and accounts go with them")
    compose(files, "down", *extra, check=False)
    return 0


# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="diffuse-chat", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    up = sub.add_parser("up", help="start the stack")
    up.add_argument("--enterprise", action="store_true",
                    help="the gateway profile: the façade acts for each person")
    up.set_defaults(run=command_up)

    doctor = sub.add_parser("doctor", help="check what is actually working")
    doctor.add_argument("--enterprise", action="store_true")
    doctor.set_defaults(run=command_doctor)

    down = sub.add_parser("down", help="stop the stack")
    down.add_argument("--volumes", action="store_true",
                      help="and forget everything it stored")
    down.set_defaults(run=command_down)

    if shutil.which("docker") is None:
        die("docker is not on the PATH.")

    args = parser.parse_args()
    sys.exit(args.run(args))


if __name__ == "__main__":
    main()
