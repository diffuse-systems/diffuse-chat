def command_down(args):
    files = ENTERPRISE_FILES if (HERE / "compose.enterprise.yaml").is_file() else DEV_FILES
    extra = ["--volumes"] if args.volumes else []
    if args.volumes:
        say("removing the volumes: conversations, uploads and accounts go with them")
    compose(files, "down", *extra, check=False)
    return 0


