# Copy to `.env` and fill in the four that have no default.
#
# `./diffuse-chat up` writes the rest itself — LibreChat's four secrets and the
# service account it uses to own the shared agent — and sets the file to 0600.
# **Never commit `.env`.** It holds a credential to your own deployment.

# Where your deployment serves the OpenAI-compatible API. The name here must be
# one the certificate carries, because LibreChat verifies it.
DIFFUSE_BASE_URL=https://coordinator.internal:8443/v1

# Your deployment's own CA, as an absolute path on this machine. It is
# /etc/diffuse/ca.crt on the coordinator. LibreChat holds no certificate of its
# own; it only has to trust the one your endpoint presents.
DIFFUSE_CA_CERT=/etc/diffuse/ca.crt

# --- developer profile -----------------------------------------------------
# An ordinary API key. Every request reaches the deployment as this key and the
# audit trail says so: one credential, no person named.
#
#   diffuse-coordinator apikey create --name chat
DIFFUSE_TOKEN=dfe_sk_...

# --- enterprise profile ----------------------------------------------------
# A **gateway** credential, and only this kind may say who a request is for.
# Whoever holds it can generate as anybody in your organisation, so it stays on
# this host: see THREAT_MODEL.md.
#
#   diffuse-coordinator apikey create --name chat --act-as
DIFFUSE_GATEWAY_TOKEN=dfe_sk_...

# A model this deployment serves. Only ever used by `./diffuse-chat up`, and
# only when it cannot read the real catalogue: the default agent it provisions
# has to name *some* model, and naming one that is served beats naming a guess.
DIFFUSE_MODEL=

# --- appearance ------------------------------------------------------------
APP_TITLE=Diffuse
CUSTOM_FOOTER=Diffuse Enterprise · your machines, your data

# Where the façade listens, on loopback.
DIFFUSE_CHAT_PORT=3080
